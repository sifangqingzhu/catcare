# Copy to .env and replace these placeholders. Never commit .env.
POSTGRES_DB=catcare
POSTGRES_USER=catcare
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Local Docker deployment; use APP_ENV=production with an HTTPS reverse proxy.
APP_ENV=development
WEB_BIND=127.0.0.1
WEB_PORT=8092
APP_ORIGIN=http://127.0.0.1:8092
ENABLE_DEMO=false
DEMO_PASSWORD=
# Optional create-only initial account. Leave both empty for self-service registration.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
# Only needed when running the Go API outside Docker:
DATABASE_URL=postgres://catcare:REPLACE_WITH_RANDOM_HEX_PASSWORD@127.0.0.1:55439/catcare?sslmode=disable
APP_HOST=127.0.0.1
API_PORT=8092
FRONTEND_DIR=../frontend/dist
